# Copy to .env. Everything is optional.

# Gemini translates idioms and slang far better than the free fallback.
# Comma-separated models are tried in order when one is busy.
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash,gemini-3.5-flash

PORT=8787

# Sentences per translation chunk (about 1 to 2 minutes of video).
CHUNK_SIZE=25

# Required before exposing the API to the internet (tunnel): the site asks for it once.
ACCESS_CODE=
# Browser origins allowed to call the API, comma-separated ('*' = any).
ALLOWED_ORIGINS=*

# ngrok tunnel (docker compose --profile tunnel up -d). Token: dashboard.ngrok.com → Your Authtoken.
NGROK_AUTHTOKEN=
NGROK_URL=https://your-name.ngrok-free.dev
